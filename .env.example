# Safe default: only the legacy synthetic route is active.
KAIROS_TRADING_MODE=DRY_RUN
KAIROS_ENVIRONMENT=dev
# KAIROS_DRY_RUN=false is retired and intentionally causes a startup error.
KAIROS_BUS_BACKEND=redis
KAIROS_REDIS_URL=redis://localhost:6379/0
KAIROS_HARD_LEVERAGE_LIMIT=10
KAIROS_SAFE_LEVERAGE_CAP=5
KAIROS_MAX_DAILY_DRAWDOWN_PCT=3
KAIROS_REQUIRE_RECONCILED_ACCOUNT=true
KAIROS_ACCOUNT_SNAPSHOT_MAX_AGE_S=60
KAIROS_REQUIRE_STRATEGIC_ALLOCATION=true
KAIROS_BREAKER_MAX_CONSECUTIVE_FAILURES=2
KAIROS_BREAKER_COOLDOWN_S=300

# PAPER remains REJECT_ALL until an exact canary/alpha revision is armed.
# Never add the five research sleeves currently marked REJECTED.
KAIROS_EVEDEX_PROFILE=DEV
KAIROS_PAPER_ACCOUNT_ID=kairos-paper-dev-01
KAIROS_PAPER_STRATEGY_ALLOWLIST=[]
# For one explicitly armed technical session only (never an automatic default):
# KAIROS_PAPER_STRATEGY_ALLOWLIST=["technical-canary@1"]
KAIROS_PAPER_PER_TRADE_RISK_FRACTION=0.0025
KAIROS_PAPER_MAX_TOTAL_OPEN_RISK_FRACTION=0.01
KAIROS_PAPER_MAX_LEVERAGE=1.0
KAIROS_PAPER_MAX_POSITION_NOTIONAL_USD=1000
KAIROS_PAPER_MIN_NOTIONAL_USD=5

# Supplied by the Compose secret/environment boundary, never committed here.
# KAIROS_PERSISTENCE_DATABASE_URL=postgresql://...
