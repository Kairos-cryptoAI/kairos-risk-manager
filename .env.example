KAIROS_BUS_BACKEND=redis
KAIROS_REDIS_URL=redis://localhost:6379/0
KAIROS_HARD_LEVERAGE_LIMIT=10
KAIROS_SAFE_LEVERAGE_CAP=5
KAIROS_MAX_DAILY_DRAWDOWN_PCT=3
KAIROS_REQUIRE_RECONCILED_ACCOUNT=true
KAIROS_ACCOUNT_SNAPSHOT_MAX_AGE_S=60
KAIROS_REQUIRE_STRATEGIC_ALLOCATION=true
KAIROS_BREAKER_MAX_CONSECUTIVE_FAILURES=2
KAIROS_BREAKER_COOLDOWN_S=300
